[global]
   workgroup = {{ samba_workgroup }}
   server string = Samba en %h
   security = user
   map to guest = Never
   log file = /var/log/samba/log.%m
   max log size = 1000

[{{ samba_share_name }}]
   comment = Recurso compartido desplegado con Ansible
   path = {{ samba_share_path }}
   read only = no
   browseable = yes
   valid users = {{ samba_system_user }}
   create mask = {{ samba_create_mask }}
   directory mask = {{ samba_directory_mask }}
